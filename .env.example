# Copy this file to .env and fill in your values.
# NEVER commit .env — only .env.example.
#
# For local development, secrets are stored in macOS Keychain and loaded via
# bin/load-secrets.sh. This file documents the env var contract that the
# loader script and production hosting both fulfill.

# ─── Teller (mTLS-authenticated) ────────────────────────────
# Teller does NOT use an API key — it uses mutual TLS.
# Cert + private key files live OUTSIDE this repo at:
#   ~/Documents/coiny-secrets/teller-sandbox/{certificate,private_key}.pem
TELLER_APPLICATION_ID=
TELLER_CERT_PATH=
TELLER_KEY_PATH=
TELLER_SIGNING_SECRET=
TELLER_ENVIRONMENT=sandbox

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/coiny

# ─── Cache (optional for MVP) ───────────────────────────────
REDIS_URL=

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=

# ─── Mobile push notifications ──────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
