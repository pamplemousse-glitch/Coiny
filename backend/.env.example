# Backend environment variables.
# Do NOT copy to .env and fill in values — use bin/load-secrets.sh + macOS Keychain.
# These docs show the env contract so you know which vars the server expects.

# ─── Teller (mTLS) ───────────────────────────────────────────
# Loaded by bin/load-secrets.sh from Keychain ("coiny-teller-application-id")
TELLER_APPLICATION_ID=
# Absolute paths — files live OUTSIDE the repo at ~/Documents/coiny-secrets/teller-sandbox/
TELLER_CERT_PATH=$HOME/Documents/coiny-secrets/teller-sandbox/certificate.pem
TELLER_KEY_PATH=$HOME/Documents/coiny-secrets/teller-sandbox/private_key.pem
# Loaded by bin/load-secrets.sh from Keychain ("coiny-teller-signing-secret").
# Leave empty until a webhook is registered — server runs in warn-mode without it.
TELLER_SIGNING_SECRET=
TELLER_ENVIRONMENT=sandbox

# ─── Field encryption ────────────────────────────────────────
# 64 lowercase hex chars (openssl rand -hex 32). Loaded by bin/load-secrets.sh
# from Keychain ("coiny-data-encryption-key"). Required unless the opt-in below
# is set; the shape is validated at boot, not at first write.
DATA_ENCRYPTION_KEY=
# Version stamped into every envelope written. Bump when rotating.
DATA_ENCRYPTION_KEY_VERSION=1
# Decrypt-only keys during a rotation: "<version>:<64 hex>", comma separated.
DATA_ENCRYPTION_KEYS_PREVIOUS=
# Store PII and credentials unencrypted. Rejected in production. Only for a
# local run or a test that means it.
ALLOW_PLAINTEXT_FIELDS=false
# Tolerate reading rows written before migration 0048 encrypted their column.
# Set false once scripts/backfill-encrypt-pii.ts reports zero rewrites.
ALLOW_LEGACY_PLAINTEXT_READS=true

# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
