<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App-target privacy manifest (PRD R-22.2). LinkKit ships its own manifest
	covering the SDK's collection; this file covers the app target.
	Must stay in sync with docs/legal/app-store-privacy-labels.md and
	docs/legal/privacy-policy.md. All collection is linked to the user's
	account and none of it is used for tracking.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Purchase History: subscription product id, expiry and original
		     transaction id, stored server-side against the account. The server is
		     the sole authority on entitlement, so this is collected, linked, and
		     never used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Name and Email Address are deliberately NOT declared.
		     Coiny does not collect either, at any layer:
		       - SignInView requests no Apple scopes at all
		         (`request.requestedScopes = []`), so the user is never shown a
		         consent sheet for them and the values never leave the device.
		       - AppleSignInSchema/GoogleSignIn in api/auth.ts omit both. The
		         schema is non-strict on purpose, so an older shipped client
		         that still sends them has them stripped by Zod rather than
		         rejected, and they never reach a column.
		       - Google's id token carries `email` and `name`; auth.ts reads
		         only `sub` and says so.
		       - The columns are gone: drizzle migration
		         0054_drop_user_identity_columns dropped users.email and
		         users.display_name (audit 2.2.1), because nothing in src/ ever
		         read either one.
		     Both entries were declared here until 2026-08-23 and were stale:
		     they outlived the collection they described. An over-declared
		     label is not a rejection risk, but it contradicted
		     privacy-policy.md section 1, which correctly states that neither is
		     asked for or stored, and the trio is required to agree.
		     Re-declare only alongside a named reader. -->
		<!-- Phone number: entered for Spinwheel SMS identity verification; passed through, not stored -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Credit info: credit score sourced from Spinwheel -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCreditInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other financial info: balances, transactions, liabilities, asset values, goals -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherFinancialInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: Apple/Google subject identifier and Coiny account id -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Device ID: APNs push token registered with the backend -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Product interaction: first-party telemetry (PRD section 24); bucketed events, no amounts, no merchant names -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Performance data: MetricKit MXMetricPayload (G3.10), reduced on device
		     to the bounded scalars of the `device_metrics` analytics event:
		     launch time, hang time, peak memory, CPU time, scroll hitch ratio
		     and foreground exit counts, plus the app build and OS major they
		     belong to. Counts and durations only; the schema
		     (backend/src/analytics/events.ts) carries no string property at all,
		     so there is no free-form field. MetricKit is a system framework, so
		     this introduces no vendor and no DPA (legal/service-providers.md is
		     unchanged). Linked because it is posted to /api/telemetry against
		     the signed-in account. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Crash data: MetricKit MXDiagnosticPayload (G3.10). Declared now, in
		     the same change as the performance half, so the three privacy
		     documents move together exactly once. The subscriber that uploads it
		     LANDED on 2026-08-23 (Services/CrashDiagnostics.swift), so this is
		     now live collection rather than an early declaration. It posts to
		     POST /api/diagnostics, which is a separate endpoint from
		     /api/telemetry because the analytics catalog rejects free-form data
		     by construction and a call stack tree cannot pass it.
		     What this is, precisely: MXCallStackTree.JSONRepresentation carries
		     binary image name, binary UUID, text-segment offset, address and
		     sample count. It is UNSYMBOLICATED, so it holds no function names
		     and no file paths, and symbolication happens off device against our
		     own dSYM. The free-form fields on MXCrashDiagnostic
		     (terminationReason, virtualMemoryRegionInfo and
		     exceptionReason.composedMessage, which Apple's own header says "may
		     have some pieces redacted") are dropped client-side rather than
		     uploaded. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other data types: date of birth, entered for Spinwheel identity verification; passed through, not stored -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults: onboarding state flag (OnboardingView.swift). CA92.1: access info from same app only -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
