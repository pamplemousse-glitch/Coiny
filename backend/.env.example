# Backend environment variables.
# Do NOT copy to .env and fill in values — use bin/load-secrets.sh + macOS Keychain.
# These docs show the env contract so you know which vars the server expects.

# ─── Teller (mTLS) ───────────────────────────────────────────
# Loaded by bin/load-secrets.sh from Keychain ("coiny-teller-application-id")
TELLER_APPLICATION_ID=
# Absolute paths — files live OUTSIDE the repo at ~/Documents/coiny-secrets/teller-sandbox/
TELLER_CERT_PATH=$HOME/Documents/coiny-secrets/teller-sandbox/certificate.pem
TELLER_KEY_PATH=$HOME/Documents/coiny-secrets/teller-sandbox/private_key.pem
# Loaded by bin/load-secrets.sh from Keychain ("coiny-teller-signing-secret").
# Leave empty until a webhook is registered — server runs in warn-mode without it.
TELLER_SIGNING_SECRET=
TELLER_ENVIRONMENT=sandbox

# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
