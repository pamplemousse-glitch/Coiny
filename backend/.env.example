# Backend environment variables.
# Copy to backend/.env (or rely on bin/load-secrets.sh + Keychain). Never commit.

# ─── Teller (mTLS) ──────────────────────────────────────────
TELLER_APPLICATION_ID=
TELLER_CERT_PATH=
TELLER_KEY_PATH=
TELLER_SIGNING_SECRET=
TELLER_ENVIRONMENT=sandbox

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/coiny

# ─── Cache (optional for MVP) ───────────────────────────────
REDIS_URL=

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=

# ─── Push ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
