{
  "name": "coiny-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:local": "vitest run --maxWorkers=3",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "format": "biome format --write src tests scripts",
    "db:migrate": "node dist/db/migrate-run.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@sentry/node": "^10.72.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "undici": "^8.5.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
