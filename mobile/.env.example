# Coiny mobile — public runtime config.
# Copy to `.env` (gitignored) and adjust. EXPO_PUBLIC_* vars are inlined into
# the JS bundle, so only put non-secret values here.

# Backend base URL. iOS Simulator can reach the host's localhost directly.
# Android emulator: use http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Teller Connect application ID (a public client identifier, not a secret).
# Find it in the Teller dashboard / macOS Keychain key `coiny-teller-application-id`.
EXPO_PUBLIC_TELLER_APPLICATION_ID=

# Teller environment: sandbox | development | production
EXPO_PUBLIC_TELLER_ENVIRONMENT=sandbox
